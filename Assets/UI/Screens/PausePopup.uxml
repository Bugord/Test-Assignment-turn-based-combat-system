<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../Common.uss" />
    <ui:VisualElement name="pause-popup" class="screen-fill popup-backdrop">
        <ui:VisualElement class="panel">
            <ui:Label text="Paused" class="title" />
            <ui:Button name="resume-button" text="Resume" class="menu-button" />
            <ui:Button name="restart-button" text="Restart" class="menu-button" />
            <ui:Button name="menu-button" text="Menu" class="menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
