.screen-fill {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.panel {
    min-width: 360px;
    padding: 32px;
    border-radius: 8px;
    background-color: rgba(20, 20, 28, 0.9);
    align-items: stretch;
}

.title {
    font-size: 36px;
    color: rgb(240, 240, 240);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.menu-button {
    height: 56px;
    font-size: 22px;
    margin: 6px 0;
}

.battle-screen {
    flex-grow: 1;
    justify-content: space-between;
    padding: 24px;
}

.battle-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.active-unit {
    font-size: 30px;
    color: rgb(240, 240, 240);
}

.turn-queue {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 12px;
}

.turn-queue-item {
    width: 88px;
    margin-right: 8px;
    padding: 6px 4px;
    align-items: center;
    border-radius: 6px;
    border-bottom-width: 4px;
    background-color: rgba(20, 20, 28, 0.8);
}

.turn-queue-item--player {
    border-bottom-color: rgb(84, 156, 232);
}

.turn-queue-item--enemy {
    border-bottom-color: rgb(214, 72, 72);
}

.turn-queue-item--active {
    width: 96px;
    background-color: rgba(92, 76, 28, 0.9);
}

.turn-queue-portrait {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

.turn-queue-item--active .turn-queue-portrait {
    width: 64px;
    height: 64px;
}

.turn-queue-name {
    max-width: 100%;
    margin-top: 4px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 14px;
    color: rgb(230, 230, 230);
    -unity-text-align: middle-center;
}

.battle-controls {
    width: 220px;
}

.battle-bottom {
    flex-direction: row;
    align-items: flex-end;
}

.choice-panel {
    flex-grow: 1;
    margin-left: 24px;
}

.hint {
    font-size: 22px;
    color: rgb(240, 240, 240);
    margin-bottom: 8px;
}

.choice-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.target-panel {
    display: none;
    align-items: flex-start;
}

.choice-button {
    min-width: 160px;
    height: 64px;
    font-size: 18px;
    margin: 4px;
}

.battle-log {
    height: 320px;
    width: 720px;
    padding: 12px 16px;
    border-radius: 8px;
    background-color: rgba(20, 20, 28, 0.8);
}

.battle-log-text {
    font-size: 18px;
    color: rgb(230, 230, 230);
    -unity-text-align: middle-left;
}
