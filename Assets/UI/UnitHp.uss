.hp-bar {
    flex-grow: 1;
    padding: 2px;
    border-radius: 4px;
    background-color: rgba(16, 12, 14, 0.85);
}

.hp-fill {
    width: 100%;
    height: 100%;
    border-radius: 2px;
    background-color: rgb(204, 52, 52);
    transition-property: width;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}
